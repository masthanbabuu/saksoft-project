# Copy to `.env` (next to docker-compose.yml). Never commit `.env`.
# Make strong values with:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# A time zone name, for example the region name from the tz database list.
TIMEZONE=<your-time-zone-name>

POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=<generate-a-strong-value>

# BACK THIS UP in your password manager. Without it, credentials saved in n8n cannot be read.
N8N_ENCRYPTION_KEY=<generate-a-strong-value>
